<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagem de fundo -->
    <ImageView
        android:id="@+id/imgFundoAdicionarReceita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_adicionar_receita"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAdicionarReceita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="24dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTituloAdicionarReceita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adicionar receita"
                android:textColor="#1E1A17"
                android:textSize="30sp"
                android:fontFamily="serif" />

            <!-- Título da Receita -->
            <TextView
                android:id="@+id/txtLabelTituloReceita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Título da Receita"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTituloReceita"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_receita"
                android:hint="Título"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E1A17"
                android:textColorHint="#8F8F8F"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textCapSentences" />

            <!-- Foto do Prato -->
            <TextView
                android:id="@+id/txtLabelFotoPrato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Foto do Prato"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerFotoPrato"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_foto_tracejada"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍🍳📷"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Adicionar foto final (opcional)"
                    android:textColor="#3E3935"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLabelCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Categoria"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editCategoria"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_receita"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E1A17"
                android:textColorHint="#8F8F8F"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textCapSentences" />

            <!-- Ingredientes -->
            <TextView
                android:id="@+id/txtLabelIngredientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ingredientes"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdicionarIngrediente"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_botao_receita"
                android:gravity="center"
                android:text="+  Adicionar ingrediente"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Modo de Preparo -->
            <TextView
                android:id="@+id/txtLabelModoPreparo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Modo de Preparo"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdicionarPasso"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_botao_receita"
                android:gravity="center"
                android:text="+  Adicionar passo"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tempo e rendimento -->
            <TextView
                android:id="@+id/txtLabelTempoRendimento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tempo de Preparo e Rendimento"
                android:textColor="#1E1A17"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerTempoRendimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo (min)"
                    android:textColor="#1E1A17"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTempoPreparo"
                    android:layout_width="48dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_campo_numero"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textColor="#1E1A17"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Porções"
                    android:textColor="#1E1A17"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPorcoes"
                    android:layout_width="48dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_campo_numero"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="0"
                    android:textColor="#1E1A17"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Botões finais -->
            <TextView
                android:id="@+id/btnSalvarPublicar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_botao_receita"
                android:gravity="center"
                android:text="SALVAR E PUBLICAR"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnVoltarReceita"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_botao_receita"
                android:gravity="center"
                android:text="VOLTAR"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>