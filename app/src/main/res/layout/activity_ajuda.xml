<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F2"
    android:fitsSystemWindows="true">

    <!-- CONTEÚDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <!-- CABEÇALHO -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">

                <TextView
                    android:id="@+id/btnMenuAjuda"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="☰"
                    android:textSize="28sp"
                    android:textColor="#172022"/>

                <TextView
                    android:id="@+id/txtTituloAjuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Como podemos\nte ajudar?"
                    android:textColor="#172022"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- ÍCONE DE SEGURANÇA SUPERIOR DIREITO -->
                <ImageView
                    android:id="@+id/btnSeguranca"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_escudo"
                    android:contentDescription="Segurança"
                    android:clickable="true"
                    android:focusable="true" />


            </RelativeLayout>

            <!-- BOTÃO DE SOCORRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/btnSocorro"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_socorro"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRITE!"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(SOCORRO)"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Toque para pedir ajuda"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"/>

                </LinearLayout>
            </LinearLayout>

            <!-- PRIMEIRA LINHA DE CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- CHAT ANÔNIMO -->
                <LinearLayout
                    android:id="@+id/btnChatAnonimo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_ajuda"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgChatAnonimo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_chat_anonimo"
                        android:contentDescription="Chat anônimo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Chat\nanônimo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172022"/>
                </LinearLayout>

                <Space
                    android:layout_width="20dp"
                    android:layout_height="match_parent"/>


                <!-- ATENDIMENTO COM IA -->
                <LinearLayout
                    android:id="@+id/btnAtendimentoIA"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_ajuda"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgAtendimentoIA"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_atendimento_ia"
                        android:contentDescription="Atendimento com IA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Atendimento\ncom IA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172022" />

                </LinearLayout>

            </LinearLayout>

            <!-- SEGUNDA LINHA DE CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp">

                <!-- CENTROS DE APOIO -->
                <LinearLayout
                    android:id="@+id/btnCentrosApoio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_ajuda"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgCentrosApoio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_centros_apoio"
                        android:contentDescription="Centros de apoio"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Centros de\napoio"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#172022"/>
                </LinearLayout>

                <Space
                    android:layout_width="20dp"
                    android:layout_height="match_parent"/>

                <!-- DENÚNCIA -->
                <LinearLayout
                    android:id="@+id/btnDenunciaAjuda"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_ajuda"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgDenuncia"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="Denúncia"
                        android:src="@drawable/ic_denuncia" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Denúncia"
                        android:textColor="#172022"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Menu inferior -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_navigation"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:weightSum="5">

        <!-- ENTRAR -->
        <LinearLayout
            android:id="@+id/menuEntrar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrar"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RECEITAS -->
        <LinearLayout
            android:id="@+id/menuReceitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receitas"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ADICIONAR -->
        <LinearLayout
            android:id="@+id/menuAdicionar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⊕"
                android:textColor="#2C2927"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adicionar"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/menuFavoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="#2C2927"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/menuPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☻"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
