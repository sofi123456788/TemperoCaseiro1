<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F0">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#333333"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Centros de apoio"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#333333"
            android:textSize="25sp" />

    </LinearLayout>


    <!-- FILTROS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="65dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro_selecionado"
                android:gravity="center"
                android:text="Todos"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="85dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:text="Delegacias"
                android:textColor="#333333"
                android:textSize="12sp" />

            <TextView
                android:layout_width="65dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:text="Apoio"
                android:textColor="#333333"
                android:textSize="12sp" />

            <TextView
                android:layout_width="65dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:text="Saúde"
                android:textColor="#333333"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- MAPA -->
    <com.example.temperocaseiro1.MapaApoioView
        android:id="@+id/mapaApoio"
        android:layout_width="match_parent"
        android:layout_height="145dp" />


    <!-- LISTA DE LOCAIS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="7dp">

        <!-- DELEGACIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="67dp"
            android:background="@drawable/bg_card_apoio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icone_roxo"
                android:gravity="center"
                android:text="♟"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delegacia da Mulher"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ouro Branco • 1,2 km"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#222222"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- CENTRO DE REFERÊNCIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="67dp"
            android:background="@drawable/bg_card_apoio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icone_azul"
                android:gravity="center"
                android:text="♥"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Centro de Referência"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conselheiro Lafaiete • 2,8 km"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#222222"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- CASA DE ACOLHIMENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="67dp"
            android:background="@drawable/bg_card_apoio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icone_laranja"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casa de Acolhimento"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ouro Branco • 3,1 km"
                    android:textColor="#666666"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#222222"
                android:textSize="28sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- BOTÃO VER NO MAPA -->
    <TextView
        android:id="@+id/btnVerMapa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_botao_mapa"
        android:gravity="center"
        android:text="▮  Ver todos no mapa"
        android:textColor="#456B16"
        android:textSize="12sp"
        android:textStyle="bold" />


    <!-- ESPAÇO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <!-- MENU INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#777777"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="#555555"
                android:textSize="9sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☻"
                android:textColor="#777777"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#555555"
                android:textSize="9sp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#456B16"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apoio"
                android:textColor="#456B16"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textColor="#777777"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mais"
                android:textColor="#555555"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>