<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3E4CD">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Centros de apoio"
            android:textColor="#222222"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TEXTO EXPLICATIVO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="5dp"
        android:text="Encontre delegacias e centros de apoio próximos de você."
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- FILTROS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/filtroTodos"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro_selecionado"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Todos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filtroDelegacias"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Delegacias"
                android:textColor="#444444"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filtroApoio"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Apoio"
                android:textColor="#444444"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filtroSaude"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Saúde"
                android:textColor="#444444"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- TÍTULO DA LISTA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:text="LOCAIS DISPONÍVEIS"
        android:textColor="#555555"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- LISTA VINDO DO BANCO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCentrosApoio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:clipToPadding="false" />

    <!-- BOTÃO DO MAPA -->
    <TextView
        android:id="@+id/btnVerMapa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/bg_botao_apoio"
        android:gravity="center"
        android:text="Ver todos no mapa"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>