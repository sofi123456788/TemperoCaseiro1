<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3E4CD">

    <!-- ÁREA PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/btnVoltar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#222222"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- MAPA ILUSTRATIVO -->
            <ImageView
                android:id="@+id/imgMapa"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mapa"
                android:contentDescription="Mapa ilustrativo do local" />

            <!-- CONTEÚDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- NOME DO LOCAL -->
                <TextView
                    android:id="@+id/txtNomeLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Delegacia da Mulher"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- CIDADE / ESTADO -->
                <TextView
                    android:id="@+id/txtCidadeEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ouro Branco • MG"
                    android:textColor="#555555"
                    android:textSize="12sp" />


                <!-- CATEGORIAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/txtCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Delegacia"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:background="@drawable/bg_tag_detalhes" />

                    <TextView
                        android:id="@+id/txtAtendimento"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Atendimento à Mulher"
                        android:textColor="#555555"
                        android:textSize="10sp"
                        android:background="@drawable/bg_tag_detalhes" />

                </LinearLayout>


                <!-- ENDEREÇO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:text="⌖"
                        android:textColor="#555555"
                        android:textSize="20sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEndereco"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="R. Cel. Albérico, 123 - Centro"
                            android:textColor="#444444"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtCidadeEndereco"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ouro Branco - MG"
                            android:textColor="#444444"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- TELEFONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="9dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:text="☎"
                        android:textColor="#555555"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Telefone"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtTelefone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="(31) 1234-5678"
                            android:textColor="#444444"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- FUNCIONAMENTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="9dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:text="◷"
                        android:textColor="#555555"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Funcionamento"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtFuncionamento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seg. a Sex. • 08:00 às 18:00"
                            android:textColor="#444444"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVISÓRIA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:background="#D7C8B1" />


                <!-- DESCRIÇÃO -->
                <TextView
                    android:id="@+id/txtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Atendimento especializado para mulheres em situação de violência."
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />


                <!-- COMO CHEGAR -->
                <TextView
                    android:id="@+id/btnComoChegar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_botao_apoio"
                    android:gravity="center"
                    android:text="⌖  Como chegar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- SALVAR FAVORITOS -->
                <TextView
                    android:id="@+id/btnFavorito"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/bg_botao_favorito"
                    android:gravity="center"
                    android:text="☆  Salvar nos favoritos"
                    android:textColor="#4D6B24"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- RODAPÉ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- INÍCIO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Início" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Início"
                android:textColor="#333333"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- CHAT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chat"
                android:contentDescription="Chat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chat"
                android:textColor="#333333"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- APOIO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apoio"
                android:contentDescription="Apoio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Apoio"
                android:textColor="#4D6B24"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- MAIS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mais"
                android:contentDescription="Mais" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mais"
                android:textColor="#333333"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>