<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3E4CD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍰 Receitas de Doces"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#3E3935"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="As melhores receitas para adoçar o seu dia!"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="20dp"/>

        <!-- BRIGADEIRO -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/img_brigadeiro"
            android:scaleType="centerCrop"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brigadeiro"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#5D4037"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Tempo: 20 minutos"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍫 Rendimento: 20 unidades"
            android:textSize="18sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:text="Ingredientes"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 1 lata de leite condensado

• 1 colher (sopa) de manteiga

• 4 colheres (sopa) de chocolate em pó

• Chocolate granulado"
            android:textSize="17sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:text="Modo de preparo"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Misture todos os ingredientes.

2. Leve ao fogo baixo mexendo sempre.

3. Quando desgrudar da panela, desligue.

4. Espere esfriar.

5. Enrole e passe no granulado."
            android:textSize="17sp"
            android:layout_marginBottom="30dp"/>

        <!-- BEIJINHO -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/img_beijinho"
            android:scaleType="centerCrop"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beijinho"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#5D4037"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Tempo: 25 minutos"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥥 Rendimento: 20 unidades"
            android:textSize="18sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:text="Ingredientes"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 1 lata de leite condensado

• 1 colher (sopa) de manteiga

• 100 g de coco ralado

• Cravos para decorar"
            android:textSize="17sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:text="Modo de preparo"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Misture todos os ingredientes.

2. Cozinhe em fogo baixo.

3. Mexa até desgrudar da panela.

4. Espere esfriar.

5. Enrole e passe no coco ralado."
            android:textSize="17sp"
            android:layout_marginBottom="30dp"/>
        <!-- PUDIM -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/img_pudim"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pudim"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#5D4037"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Tempo: 1 hora"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍮 Rendimento: 10 porções"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredientes"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 1 lata de leite condensado

• 2 medidas da lata de leite

• 3 ovos

• 1 xícara de açúcar

• 1/2 xícara de água"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo de preparo"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Derreta o açúcar até formar um caramelo.

2. Espalhe na forma.

3. Bata os demais ingredientes no liquidificador.

4. Despeje na forma.

5. Asse em banho-maria por cerca de 1 hora."
            android:textSize="17sp"
            android:layout_marginBottom="30dp" />

        <!-- BOLO DE CENOURA -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/img_bolo_cenoura"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bolo de Cenoura"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#5D4037"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Tempo: 50 minutos"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥕 Rendimento: 12 fatias"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredientes"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 3 cenouras médias

• 4 ovos

• 1 xícara de óleo

• 2 xícaras de açúcar

• 2 e 1/2 xícaras de farinha de trigo

• 1 colher (sopa) de fermento"

            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo de preparo"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#795548" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Bata no liquidificador a cenoura, os ovos e o óleo.

2. Misture com o açúcar e a farinha.

3. Acrescente o fermento.

4. Coloque em forma untada.

5. Asse em forno preaquecido a 180°C por aproximadamente 40 minutos."
            android:textSize="17sp"
            android:layout_marginBottom="40dp" />

    </LinearLayout>

</ScrollView>