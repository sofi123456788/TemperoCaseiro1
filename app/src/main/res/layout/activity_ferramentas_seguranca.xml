<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#FFF8ED" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="24dp">
  <TextView android:id="@+id/btnVoltarSeguranca" android:layout_width="wrap_content"
   android:layout_height="56dp" android:gravity="center_vertical" android:text="‹  Voltar"
   android:textSize="18sp" android:textColor="#263526" android:clickable="true" android:focusable="true"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="Ferramentas de segurança" android:textSize="23sp" android:textStyle="bold" android:textColor="#263526"
   android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="Escolha quais recursos aparecem durante o atendimento. As preferências ficam apenas neste aparelho."
   android:layout_marginTop="12dp" android:textColor="#354534" android:textSize="15sp"/>
  <Switch android:id="@+id/switchSaidaRapida" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:layout_marginTop="25dp"
   android:text="Mostrar botão de saída rápida no chat" android:textColor="#263526"/>
  <Switch android:id="@+id/switchAvisos" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:layout_marginTop="18dp"
   android:text="Exibir contatos de apoio durante o chat" android:textColor="#263526"/>
  <Button android:id="@+id/btnCentralMulher" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:layout_marginTop="28dp"
   android:text="Ligar 180 — Central de Atendimento à Mulher" android:textAllCaps="false"/>
  <Button android:id="@+id/btnPolicia" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:layout_marginTop="8dp"
   android:text="Ligar 190 — Emergência" android:textAllCaps="false"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="24dp" android:text="Em perigo imediato, procure um local seguro e acione a emergência. A IA não substitui atendimento especializado."
   android:textColor="#354534" android:textSize="14sp"/>
 </LinearLayout>
</ScrollView>
