<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F3E4CD" android:fillViewport="true"
    android:fitsSystemWindows="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="22dp"
        android:paddingEnd="22dp" android:paddingTop="14dp" android:paddingBottom="28dp">
        <TextView android:id="@+id/btnVoltarSeguranca"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="‹  Voltar" android:textColor="#3E3935"
            android:textSize="20sp" android:fontFamily="sans"
            android:gravity="center_vertical" android:clickable="true"
            android:focusable="true" android:contentDescription="Voltar"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Ferramentas de segurança"
            android:textColor="#322A24" android:textStyle="bold"
            android:textSize="25sp" android:fontFamily="sans"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Personalize a experiência de apoio e encontre contatos importantes."
            android:textColor="#6D6257" android:textSize="15sp" android:fontFamily="sans"
            android:lineSpacingExtra="3dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="PREFERÊNCIAS"
            android:textColor="#526B37" android:textStyle="bold"
            android:textSize="13sp" android:fontFamily="sans"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:padding="16dp" android:background="@drawable/bg_security_card">
            <Switch android:id="@+id/switchSaidaRapida"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:text="Mostrar saída rápida no chat"
                android:textColor="#322A24" android:textSize="14sp"
                android:fontFamily="sans"/>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="9dp" android:layout_marginBottom="9dp"
                android:background="#E9DED0"/>
            <Switch android:id="@+id/switchAvisos"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:text="Exibir contatos de apoio no chat"
                android:textColor="#322A24" android:textSize="14sp"
                android:fontFamily="sans"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Essas opções são salvas apenas neste aparelho."
            android:textColor="#75695C" android:textSize="12sp" android:fontFamily="sans"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="CONTATOS DE APOIO"
            android:textColor="#526B37" android:textStyle="bold"
            android:textSize="13sp" android:fontFamily="sans"/>
        <TextView android:id="@+id/btnCentralMulher"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_security_card"
            android:gravity="center_vertical" android:paddingStart="17dp"
            android:text="180   •   Central de Atendimento à Mulher  ›"
            android:textColor="#322A24" android:textSize="14sp" android:fontFamily="sans"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnPolicia"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_security_card"
            android:gravity="center_vertical" android:paddingStart="17dp"
            android:text="190   •   Emergência  ›"
            android:textColor="#9F453B" android:textSize="14sp" android:fontFamily="sans"
            android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Em perigo imediato, procure um local seguro. A Aurora é uma ferramenta complementar e não substitui o atendimento especializado."
            android:textColor="#6D6257" android:textSize="13sp"
            android:fontFamily="sans" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
