<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/telaLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagem de fundo completa com as decorações -->
    <ImageView
        android:id="@+id/imgFundoLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_background"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Conteúdo da tela -->
    <LinearLayout
        android:id="@+id/containerLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Espaço superior -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="105dp" />

        <!-- Logo Tempero Caseiro -->
        <ImageView
            android:id="@+id/imgLogoTempero"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/logo_tempero"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Tempero Caseiro" />

        <!-- Espaço entre logo e campos -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- Campo E-mail -->
        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_campo_login"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- Campo Senha -->
        <EditText
            android:id="@+id/editSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_campo_login"
            android:hint="Senha"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- Botão Entrar -->
        <TextView
            android:id="@+id/btnEntrar"
            android:layout_width="136dp"
            android:layout_height="38dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_botao_verde"
            android:gravity="center"
            android:text="Entrar"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Esqueceu senha -->
        <TextView
            android:id="@+id/txtEsqueceuSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Esqueceu sua senha?"
            android:textColor="@color/verde_oliva"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Divisor "ou entre com" -->
        <LinearLayout
            android:id="@+id/containerDivisor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/linha_divisoria" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="ou entre com"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/linha_divisoria" />

        </LinearLayout>

        <!-- Botões Google e Facebook -->
        <LinearLayout
            android:id="@+id/containerSocial"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Botão Google -->
            <LinearLayout
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_botao_social"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/google_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Google"
                    android:textColor="@color/texto_hint"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Botão Facebook -->
            <LinearLayout
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_botao_social"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/facebook_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Facebook" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Facebook"
                    android:textColor="@color/texto_hint"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Ainda não tem conta -->
        <TextView
            android:id="@+id/txtAindaNaoTemConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ainda não tem uma conta?"
            android:textColor="@color/texto_hint"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Criar conta -->
        <TextView
            android:id="@+id/txtCriarConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Criar conta"
            android:textColor="@color/verde_oliva"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>