<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3E4CD">

    <!-- Título da tela -->
    <TextView
        android:id="@+id/txtTituloReceitasBD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp"
        android:text="Todas as Receitas"
        android:textColor="#1E1A17"
        android:textSize="30sp"
        android:fontFamily="serif"
        android:textStyle="bold" />

    <!--
        ScrollView permite que o usuário deslize
        a tela para visualizar todas as receitas.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!--
            Dentro desse LinearLayout serão criados
            automaticamente os cards das receitas.
        -->
        <LinearLayout
            android:id="@+id/layoutReceitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp" />

    </ScrollView>

    <!-- Botão para voltar -->
    <TextView
        android:id="@+id/btnVoltarReceitasBD"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/bg_botao_receita"
        android:gravity="center"
        android:text="VOLTAR"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>