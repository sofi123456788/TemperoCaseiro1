<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo da tela -->
    <ImageView
        android:id="@+id/imgFundoCodigoRecuperacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_background"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogoCodigoRecuperacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/logo_tempero"
        android:scaleType="fitCenter"
        android:contentDescription="Logo Tempero Caseiro"
        app:layout_constraintWidth_percent="0.50"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloCodigoRecuperacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confira o e-mail informado&#10;e digite o código enviado"
        android:textColor="@color/verde_oliva"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="54dp"
        app:layout_constraintWidth_percent="0.86"
        app:layout_constraintTop_toBottomOf="@id/imgLogoCodigoRecuperacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo código de recuperação -->
    <EditText
        android:id="@+id/editCodigoRecuperacao"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_campo_login"
        android:hint="Código de recuperação"
        android:inputType="number"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_codigo_recuperacao"
        android:drawablePadding="10dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_hint"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/txtTituloCodigoRecuperacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha esquerda -->
    <View
        android:id="@+id/linhaEsquerdaReenviar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="12dp"
        android:background="@color/linha_divisoria"
        app:layout_constraintTop_toTopOf="@id/txtReenviarCodigo"
        app:layout_constraintBottom_toBottomOf="@id/txtReenviarCodigo"
        app:layout_constraintStart_toStartOf="@id/editCodigoRecuperacao"
        app:layout_constraintEnd_toStartOf="@id/txtReenviarCodigo" />

    <!-- Reenviar código -->
    <TextView
        android:id="@+id/txtReenviarCodigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reenviar código"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="42dp"
        app:layout_constraintTop_toBottomOf="@id/editCodigoRecuperacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha direita -->
    <View
        android:id="@+id/linhaDireitaReenviar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:background="@color/linha_divisoria"
        app:layout_constraintTop_toTopOf="@id/txtReenviarCodigo"
        app:layout_constraintBottom_toBottomOf="@id/txtReenviarCodigo"
        app:layout_constraintStart_toEndOf="@id/txtReenviarCodigo"
        app:layout_constraintEnd_toEndOf="@id/editCodigoRecuperacao" />

    <!-- Botão confirmar -->
    <TextView
        android:id="@+id/btnConfirmarCodigoRecuperacao"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_botao_verde"
        android:gravity="center"
        android:text="Confirmar"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/txtReenviarCodigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>