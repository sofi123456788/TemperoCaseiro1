<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="#F3E4CD">

    <!-- CONTEÚDO PRINCIPAL -->
    <ScrollView
        android:id="@+id/scrollConfiguracoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="20dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnVoltarConfiguracoes"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:text="‹"
                    android:textSize="36sp"
                    android:textColor="#3E3935"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Voltar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Configurações"
                    android:textColor="#3E3935"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ESPAÇO FLEXÍVEL -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ÍCONE CENTRAL -->
            <TextView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_categoria_circulo"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#685038"
                android:textSize="55sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Sua conta"
                android:textColor="#322A24"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Gerencie sua conta e conheça mais sobre o Tempero Caseiro."
                android:textColor="#75685C"
                android:textSize="14sp" />

            <!-- ESPAÇO FLEXÍVEL -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- EXCLUIR CONTA -->
            <LinearLayout
                android:id="@+id/layoutExcluirConta"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#B05248"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excluir minha conta"
                        android:textColor="#B05248"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Exclusão permanente"
                        android:textColor="#75685C"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#B05248"
                    android:textSize="30sp" />
            </LinearLayout>

            <!-- SOBRE O APLICATIVO -->
            <LinearLayout
                android:id="@+id/layoutSobreAplicativo"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textColor="#685038"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sobre o aplicativo"
                        android:textColor="#322A24"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Conheça nosso projeto"
                        android:textColor="#75685C"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#685038"
                    android:textSize="30sp" />
            </LinearLayout>

            <!-- ESPAÇO FLEXÍVEL -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- INFORMAÇÕES DO APP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="Tempero Caseiro • Feito com carinho ♡"
                android:textColor="#75685C"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Versão 1.0"
                android:textColor="#75685C"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- RODAPÉ ORIGINAL -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_navigation"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:weightSum="5">

        <!-- ENTRAR -->
        <LinearLayout
            android:id="@+id/menuEntrar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrar"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RECEITAS -->
        <LinearLayout
            android:id="@+id/menuReceitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receitas"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ADICIONAR -->
        <LinearLayout
            android:id="@+id/menuAdicionar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⊕"
                android:textColor="#2C2927"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adicionar"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/menuFavoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="#2C2927"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/menuPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☻"
                android:textColor="#2C2927"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#2C2927"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
