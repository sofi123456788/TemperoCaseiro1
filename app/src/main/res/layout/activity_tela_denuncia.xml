<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7E7CF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- CABEÇALHO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="Voltar"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#202020" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Denúncia"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

        </RelativeLayout>


        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="Selecione o tipo de violência"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- FÍSICA -->
        <LinearLayout
            android:id="@+id/layoutFisica"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Violência física"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fisica" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Física"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- PSICOLÓGICA -->
        <LinearLayout
            android:id="@+id/layoutPsicologica"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Violência psicológica"
                android:scaleType="centerInside"
                android:src="@drawable/ic_psicologica" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Psicológica"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- SEXUAL -->
        <LinearLayout
            android:id="@+id/layoutSexual"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Violência sexual"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Sexual"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- PATRIMONIAL -->
        <LinearLayout
            android:id="@+id/layoutPatrimonial"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Violência patrimonial"
                android:scaleType="centerInside"
                android:src="@drawable/ic_patrimonial" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Patrimonial"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- AMEAÇA / PERSEGUIÇÃO -->
        <LinearLayout
            android:id="@+id/layoutAmeaca"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Ameaça ou perseguição"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ameaca" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Ameaça / Perseguição"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- OUTRA -->
        <LinearLayout
            android:id="@+id/layoutOutra"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/bg_item_denuncia"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Outra violência"
                android:scaleType="centerInside"
                android:src="@drawable/ic_outra" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Outra"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#333333"
                android:textSize="28sp" />

        </LinearLayout>


        <!-- RELATO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="Conte o que aconteceu: "
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editRelato"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/bg_campo_denuncia"
            android:gravity="top|start"
            android:hint="Escreva aqui..."
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="#333333"
            android:textColorHint="#8A8A8A"
            android:textSize="13sp" />


        <!-- ANEXOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="51dp"
            android:layout_marginBottom="14dp"
            android:text="Adicionar anexos (opcional)"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- FOTO -->
            <LinearLayout
                android:id="@+id/btnFoto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Adicionar foto"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="#252525" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Foto"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ÁUDIO -->
            <LinearLayout
                android:id="@+id/btnAudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Adicionar áudio"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="#252525" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Áudio"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- VÍDEO -->
            <LinearLayout
                android:id="@+id/btnVideo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Adicionar vídeo"
                    android:src="@android:drawable/ic_menu_slideshow"
                    android:tint="#252525" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Vídeo"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- BOTÃO -->
        <Button
            android:id="@+id/btnEnviarDenuncia"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_botao_denuncia"
            android:text="Enviar denúncia"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- SIGILO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Sua identidade será mantida em sigilo."
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>