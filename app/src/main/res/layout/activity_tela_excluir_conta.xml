<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/main"
 android:layout_width="match_parent"
 android:layout_height="match_parent"
 android:fitsSystemWindows="true"
 android:fillViewport="true"
 android:background="#F3E4CD">
 <LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="24dp"
  android:paddingEnd="24dp"
  android:paddingTop="12dp"
  android:paddingBottom="30dp">
  <TextView
   android:id="@+id/btnVoltarExcluir"
   android:layout_width="wrap_content"
   android:layout_height="48dp"
   android:gravity="center_vertical"
   android:text="‹  Voltar"
   android:textSize="19sp"
   android:textColor="#3E3935"
   android:contentDescription="Voltar às configurações"
   android:clickable="true"
   android:focusable="true"/>
  <ImageView
   android:id="@+id/imgLogoExcluirConta"
   android:layout_width="150dp"
   android:layout_height="150dp"
   android:layout_gravity="center_horizontal"
   android:layout_marginTop="16dp"
   android:src="@drawable/logo_tempero"
   android:scaleType="fitCenter"
   android:contentDescription="Logo Tempero Caseiro"/>
  <TextView
   android:id="@+id/txtDesejaExcluirConta"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="12dp"
   android:text="Excluir sua conta?"
   android:textColor="#322A24"
   android:textStyle="bold"
   android:textSize="27sp"
   android:gravity="center"/>
  <TextView
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="10dp"
   android:text="Antes de continuar, confira o que acontece com sua conta."
   android:textSize="15sp"
   android:textColor="#6D6257"
   android:gravity="center"/>
  <LinearLayout
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="28dp"
   android:background="@drawable/bg_security_card"
   android:padding="20dp"
   android:orientation="vertical">
   <TextView
    android:id="@+id/txtAvisoExcluirConta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Atenção: ação permanente"
    android:textSize="17sp"
    android:textStyle="bold"
    android:textColor="#A64C42"/>
   <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:lineSpacingExtra="4dp"
    android:text="• Sua conta será excluída.&#10;• Você perderá o acesso a este perfil.&#10;• A exclusão não poderá ser desfeita."
    android:textSize="14sp"
    android:textColor="#443A32"/>
  </LinearLayout>
  <Button
   android:id="@+id/btnExcluirConta"
   android:layout_width="match_parent"
   android:layout_height="56dp"
   android:layout_marginTop="28dp"
   android:text="Excluir minha conta"
   android:textAllCaps="false"
   android:textStyle="bold"
   android:textSize="16sp"
   android:textColor="#FFFFFF"
   android:backgroundTint="#A64C42"/>
  <Button
   android:id="@+id/btnCancelarExclusao"
   android:layout_width="match_parent"
   android:layout_height="54dp"
   android:layout_marginTop="12dp"
   android:text="Cancelar e voltar"
   android:textAllCaps="false"
   android:textStyle="bold"
   android:textSize="16sp"
   android:textColor="#34442E"
   android:backgroundTint="#FFFFFF"/>
 </LinearLayout>
</ScrollView>