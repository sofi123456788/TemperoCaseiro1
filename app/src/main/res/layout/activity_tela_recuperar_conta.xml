<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo da tela -->
    <ImageView
        android:id="@+id/imgFundoRecuperarConta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_background"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão voltar -->
    <TextView
        android:id="@+id/btnVoltarRecuperarConta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogoRecuperarConta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/logo_tempero"
        android:scaleType="fitCenter"
        android:contentDescription="Logo Tempero Caseiro"
        app:layout_constraintWidth_percent="0.43"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.23"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloRecuperarConta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar sua conta"
        android:textColor="@color/texto_principal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="46dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogoRecuperarConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtituloRecuperarConta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite seu e-mail de recuperação"
        android:textColor="@color/texto_principal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloRecuperarConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo e-mail recuperação -->
    <EditText
        android:id="@+id/editEmailRecuperacao"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_campo_login"
        android:hint="E-mail de recuperação"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_email_recuperacao"
        android:drawablePadding="10dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_hint"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloRecuperarConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão confirmar -->
    <TextView
        android:id="@+id/btnConfirmarEmailRecuperacao"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_botao_verde"
        android:gravity="center"
        android:text="Confirmar"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>