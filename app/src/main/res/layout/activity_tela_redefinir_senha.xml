<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo -->
    <ImageView
        android:id="@+id/imgFundoRedefinirSenha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_background"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogoRedefinirSenha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/logo_tempero"
        android:scaleType="fitCenter"
        android:contentDescription="Logo Tempero Caseiro"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloRedefinirSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crie uma nova senha"
        android:textColor="@color/verde_oliva"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="42dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogoRedefinirSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtituloRedefinirSenha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Digite sua nova senha e confirme abaixo"
        android:textColor="@color/texto_principal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintTop_toBottomOf="@id/txtTituloRedefinirSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nova senha -->
    <EditText
        android:id="@+id/editNovaSenha"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_campo_login"
        android:hint="Nova senha"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_senha"
        android:drawablePadding="10dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_hint"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloRedefinirSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Confirmar nova senha -->
    <EditText
        android:id="@+id/editConfirmarNovaSenha"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_campo_login"
        android:hint="Confirmar nova senha"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_senha"
        android:drawablePadding="10dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_hint"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/editNovaSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão confirmar -->
    <TextView
        android:id="@+id/btnConfirmarNovaSenha"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_botao_verde"
        android:gravity="center"
        android:text="Confirmar nova senha"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/editConfirmarNovaSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>