<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardCentroApoio"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_apoio"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/iconeCentro"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icone_roxo"
        android:gravity="center"
        android:text="♥"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/textNomeCentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nome do centro"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLocalizacaoCentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cidade - Estado"
            android:textColor="#666666"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/textTipoCentro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tipo"
            android:textColor="#456B16"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/arrowCentro"
        android:layout_width="25dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="›"
        android:textColor="#222222"
        android:textSize="28sp" />

</LinearLayout>